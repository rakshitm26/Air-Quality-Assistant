# AirGuard AI — Environment Configuration
# Copy this file to .env and fill in your API key

# ── Gemini API ──────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── WAQI (World Air Quality Index) — Real AQI data for any lat/lon ──────────
# Free token: use "demo" to test, or get your own at https://aqicn.org/data-platform/token/
WAQI_TOKEN=demo

# ── Optional: OpenWeatherMap for live AQI data ──────────────────────────────
OPENWEATHER_API_KEY=

# ── Optional: IP Geolocation for auto-detecting user city ───────────────────
IPINFO_TOKEN=
